  },

  "assets": {
    "logo": "assets/logo/logo.png",
    "background": "assets/backgrounds/background.png",
    "qr": "assets/qr/qr.png",
    "icons": {
      "housewife": "assets/icons/housewife.svg",
      "retired": "assets/icons/retired.svg",
      "employee": "assets/icons/employee.svg",
      "whatsapp": "assets/icons/whatsapp.svg",
      "email": "assets/icons/email.svg"
    }
  },

  "template": {
    "id": "taysir",
    "name": "باقة تيسير"
  },

  "locale": {
    "rtl": true,
    "language": "ar-SA",
    "languages": [
      "ar"
    ],
    "currency": "SAR"
  },

  "tokens": {
    "colors": {
      "primary": "#083B66",
      "secondary": "#00A6A6",
      "background": "#F5F7FA",
      "card": "#FFFFFF",
      "text": "#1F2937",
      "white": "#FFFFFF",
      "transparent": "transparent"
    },

    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px"
    },

    "radius": {
      "sm": "8px",
      "md": "12px",
      "lg": "20px"
    },

    "font": {
      "primary": "Cairo",
      "fallback": "IBM Plex Sans Arabic"
    },

    "shadow": {
      "enabled": true,
      "sm": "0 2px 8px rgba(0,0,0,0.08)",
      "md": "0 4px 12px rgba(0,0,0,0.10)",
      "lg": "0 10px 30px rgba(0,0,0,0.15)"
    },

    "border": {
      "default": "1px solid #E5E7EB"
    },

    "transition": {
      "default": "all .3s ease"
    }
  },

  "layout": {
    "default": "instagram_post",
    "sizes": {
      "instagram_post": {
        "width": 1080,
        "height": 1350
      },
      "instagram_story": {
        "width": 1080,
        "height": 1920
      },
      "square": {
        "width": 1080,
        "height": 1080
      },
      "a4": {
        "width": 2480,
        "height": 3508
      }
    }
  },

  "export": {
    "default": "png",
    "filename": "TERA",
    "quality": 1,
    "scale": 2,
    "background": "#FFFFFF",
    "formats": [
      "png",
      "pdf",
      "jpeg",
      "webp"
    ]
  },

  "urlTemplates": {
    "whatsapp": "https://wa.me/{number}",
    "email": "mailto:{email}"
  },

  "features": {
    "showQR": true,
    "showContact": true,
    "showFooter": true,
    "enableAnimation": true,
    "enableExport": true
  }
